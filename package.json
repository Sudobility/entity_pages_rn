    "lint:fix": "eslint . --ext ts,tsx --ignore-pattern dist --ignore-pattern node_modules --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74",
    "nativewind": ">=4",
    "@tanstack/react-query": ">=5",
    "@sudobility/design": "^1.1.63",
    "@sudobility/entity_client": "^0.0.52",
    "@sudobility/types": "^1.9.75"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@tanstack/react-query": "~5.104.5",
    "@types/react": "~18.3.31",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "clsx": "~2.1.1",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "jsdom": "~28.1.0",
    "nativewind": "~4.2.7",
    "prettier": "~3.9.10",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "react-native": "~0.81.6",
    "tailwindcss": "~3.4.19",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
